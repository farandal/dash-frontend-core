{
	"name": "dash-dialog",
	"version": "1.0.2",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"lint": "eslint --ext .ts,.tsx .",
		"format": "pnpm prettier --write . && pnpm format-check && pnpm lint",
		"lint:check": "pnpm prettier --check .",
		"lint:fix": "pnpm prettier --write .",
		"check-updates": "pnpm npm-check-updates",
		"updates-packages": "pnpm npm-check-updates -u",
		"build": "tsup"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"dependencies": {
		"@emotion/react": "latest",
		"@emotion/styled": "latest",
		"@mui/material": "^7.3.10",
		"@rollup/plugin-alias": "latest",
		"@rollup/plugin-commonjs": "latest",
		"@rollup/plugin-node-resolve": "latest",
		"@rollup/plugin-replace": "latest",
		"@rollup/plugin-typescript": "latest",
		"query-string": "latest",
		"react-admin": "5.14.6",
		"react-custom-scrollbars-2": "latest",
		"react-draggable": "latest",
		"react-loading-overlay-ts": "latest",
		"react-query": "latest",
		"react-redux": "latest",
		"react-router": "^7.9.6",
		"react-router-dom": "^7.9.6",
		"react-spinners": "latest",
		"react-toastify": "latest",
		"rollup-plugin-cleaner": "latest",
		"rollup-plugin-dts": "latest",
		"rollup-plugin-peer-deps-external": "latest",
		"rollup-plugin-svg": "latest"
	},
	"devDependencies": {
		"@babel/core": "latest",
		"@babel/preset-env": "latest",
		"@babel/preset-react": "latest",
		"@babel/preset-typescript": "latest",
		"@commitlint/config-conventional": "latest",
		"@types/node": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@zerollup/ts-transform-paths": "latest",
		"babel-loader": "latest",
		"eslint": "latest",
		"eslint-config-airbnb": "latest",
		"eslint-config-airbnb-typescript": "latest",
		"eslint-config-prettier": "latest",
		"dash-eslint": "workspace:*",
		"eslint-import-resolver-typescript": "latest",
		"eslint-plugin-html": "latest",
		"eslint-plugin-import": "latest",
		"eslint-plugin-jsdoc": "latest",
		"eslint-plugin-json": "latest",
		"eslint-plugin-jsx-a11y": "latest",
		"eslint-plugin-prettier": "latest",
		"eslint-plugin-react": "latest",
		"eslint-plugin-react-hooks": "latest",
		"dash-prettier": "workspace:*",
		"query-string": "latest",
		"react-dom": "latest",
		"rollup": "latest",
		"rollup-plugin-copy-assets": "latest",
		"rollup-plugin-external-globals": "latest",
		"rollup-plugin-includepaths": "latest",
		"rollup-plugin-less": "latest",
		"rollup-plugin-node-resolve": "latest",
		"rollup-plugin-postcss": "latest",
		"rollup-plugin-sourcemaps": "latest",
		"rollup-plugin-typescript2": "latest",
		"dash-tsconfig": "workspace:*",
		"tsc": "latest",
		"tsc-alias": "latest",
		"ttypescript": "latest",
		"typescript": "latest"
	},
	"peerDependencies": {
		"react": "latest",
		"react-custom-scrollbars-2": "^4.5.0",
		"react-dom": "latest"
	},
	"eslintConfig": {
		"extends": "react-app"
	},
	"_todo_storybook": {
		"eslint-plugin-storybook": "latest"
	},
	"module": "dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*.js",
		"./src/*": "./dist/*.js"
	},
	"publishConfig": {
		"access": "public",
		"registry": "http://localhost:4873"
	},
	"files": [
		"dist",
		"src"
	],
	"typesVersions": {
		"*": {
			"src/*": [
				"src/*",
				"src/*/index"
			],
			"*": [
				"src/*",
				"src/*/index"
			]
		}
	}
}
