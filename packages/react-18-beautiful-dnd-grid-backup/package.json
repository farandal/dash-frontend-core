{
  "name": "react-18-beautiful-dnd-grid",
  "version": "1.0.0",
  "description": "Grid management for react-beautiful-dnd",
  "main": "lib/index.js",
  "private": false,
  "type": "module",
  "files": [
    "lib",
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tsc": "tsc -p tsconfig.json",
    "test": "jest --watch --config jest.config.json",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "build": "rm -rf lib && mkdir lib && TSC_COMPILE_ON_ERROR=true tsc -p tsconfig.build.json",
    "test:pack": "npm run build && npm pack",
    "test:demo": "npm run build && rm -rf demo/src/lib && cp -r lib demo/src/lib",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathieueveillard/react-beautiful-dnd-grid.git"
  },
  "keywords": [
    "react",
    "dnd",
    "grid",
    "component"
  ],
  "author": "Mathieu Eveillard",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mathieueveillard/react-beautiful-dnd-grid/issues"
  },
  "homepage": "https://github.com/mathieueveillard/react-beautiful-dnd-grid#readme",
  "devDependencies": {
    "@types/enzyme": "latest",
    "@types/enzyme-adapter-react-16": "latest",
    "@types/jest": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/uuid": "latest",
    "enzyme": "latest",
    "enzyme-adapter-react-16": "latest",
    "jest": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "react-dom": "latest",
    "ts-jest": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "@hello-pangea/dnd": "latest",
    "nanoid": "latest",
    "react": "latest"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "prettier": {
    "printWidth": 120
  }
}
