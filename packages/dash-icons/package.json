{
	"name": "dash-icons",
	"version": "1.0.2",
	"main": "dist/index.cjs",
	"type": "module",
	"files": [
		"dist"
	],
	"types": "dist/index.d.ts",
	"scripts": {
		"svgr": "svgr src/icons/svg --index-template svgIndexTemplate.cjs --icon --out-dir src/icons/svgr --no-dimensions --typescript",
		"rollup": "rollup --config rollup.config.ts --bundleConfigAsCjs",
		"_prepare": "npm run rollup",
		"lint": "eslint --ext .ts,.tsx .",
		"test": "jest --json",
		"lint:check": "prettier --check .",
		"lint:fix": "prettier --write .",
		"build": "tsup"
	},
	"dependencies": {
		"@jest/globals": "latest",
		"@rollup/plugin-commonjs": "latest",
		"@rollup/plugin-image": "latest",
		"@rollup/plugin-node-resolve": "latest",
		"@rollup/plugin-replace": "latest",
		"@rollup/plugin-typescript": "latest",
		"@testing-library/jest-dom": "latest",
		"@testing-library/react": "latest",
		"@testing-library/user-event": "latest",
		"react": "19.2.8",
		"rollup-plugin-cleaner": "latest",
		"rollup-plugin-copy-assets": "latest",
		"rollup-plugin-dts": "latest",
		"rollup-plugin-peer-deps-external": "latest",
		"rollup-plugin-postcss": "latest",
		"rollup-plugin-svg": "latest"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"@babel/core": "latest",
		"@babel/preset-env": "latest",
		"@babel/preset-react": "latest",
		"@babel/preset-typescript": "latest",
		"@rollup/plugin-alias": "latest",
		"@svgr/cli": "latest",
		"@svgr/rollup": "latest",
		"@types/jest": "latest",
		"@types/node": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"babel-loader": "latest",
		"eslint": "latest",
		"dash-eslint": "workspace:*",
		"eslint-config-airbnb": "latest",
		"eslint-config-airbnb-typescript": "latest",
		"eslint-config-prettier": "latest",
		"eslint-import-resolver-typescript": "latest",
		"eslint-plugin-html": "latest",
		"eslint-plugin-import": "latest",
		"eslint-plugin-jsdoc": "latest",
		"eslint-plugin-json": "latest",
		"eslint-plugin-jsx-a11y": "latest",
		"eslint-plugin-prettier": "latest",
		"eslint-plugin-react": "latest",
		"eslint-plugin-react-hooks": "latest",
		"jest": "latest",
		"jest-dom": "latest",
		"jest-environment-jsdom": "latest",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"rollup": "latest",
		"rollup-plugin-external-globals": "latest",
		"rollup-plugin-includepaths": "latest",
		"rollup-plugin-less": "latest",
		"rollup-plugin-node-resolve": "latest",
		"rollup-plugin-sourcemaps": "latest",
		"rollup-plugin-terser": "latest",
		"rollup-plugin-typescript2": "latest",
		"ts-jest": "latest",
		"ts-node": "latest",
		"tsc": "latest",
		"tsc-alias": "latest",
		"typescript": "latest",
		"dash-tsconfig": "workspace:*"
	},
	"module": "dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "http://localhost:4873"
	}
}
