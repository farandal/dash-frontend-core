{
	"name": "dash-interfaces",
	"version": "1.0.2",
	"main": "dist/index.cjs",
	"type": "module",
	"scripts": {
		"lint": "eslint --ext .ts,.tsx .",
		"format": "pnpm prettier --write . && pnpm format-check && pnpm lint",
		"lint:check": "pnpm prettier --check .",
		"lint:fix": "pnpm prettier --write .",
		"check-updates": "pnpm npm-check-updates",
		"updates-packages": "pnpm npm-check-updates -u",
		"build": "tsup"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"dependencies": {},
	"devDependencies": {
		"@babel/core": "latest",
		"@babel/preset-env": "latest",
		"@babel/preset-react": "latest",
		"@babel/preset-typescript": "latest",
		"@commitlint/config-conventional": "latest",
		"@types/node": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@zerollup/ts-transform-paths": "latest",
		"babel-loader": "latest",
		"eslint": "latest",
		"eslint-config-airbnb": "latest",
		"eslint-config-airbnb-typescript": "latest",
		"eslint-config-prettier": "latest",
		"dash-eslint": "workspace:*",
		"eslint-import-resolver-typescript": "latest",
		"eslint-plugin-html": "latest",
		"eslint-plugin-import": "latest",
		"eslint-plugin-jsdoc": "latest",
		"eslint-plugin-json": "latest",
		"eslint-plugin-jsx-a11y": "latest",
		"eslint-plugin-prettier": "latest",
		"eslint-plugin-react": "latest",
		"eslint-plugin-react-hooks": "latest",
		"dash-prettier": "workspace:*",
		"query-string": "latest",
		"react-dom": "latest",
		"rollup": "latest",
		"rollup-plugin-copy-assets": "latest",
		"rollup-plugin-external-globals": "latest",
		"rollup-plugin-includepaths": "latest",
		"rollup-plugin-less": "latest",
		"rollup-plugin-node-resolve": "latest",
		"rollup-plugin-postcss": "latest",
		"rollup-plugin-sourcemaps": "latest",
		"rollup-plugin-typescript2": "latest",
		"dash-tsconfig": "workspace:*",
		"tsc": "latest",
		"tsc-alias": "latest",
		"typescript": "latest"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"eslintConfig": {
		"extends": "react-app"
	},
	"todo_storybook": {
		"eslint-plugin-storybook": "latest"
	},
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "http://localhost:4873"
	},
	"files": [
		"dist"
	]
}
