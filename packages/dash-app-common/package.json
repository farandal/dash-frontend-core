{
	"name": "dash-app-common",
	"version": "1.0.0",
	"description": "Common defaults and utilities for Dash applications - provides pre-configured components, extensions, pages, filters, and schemas",
	"private": true,
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"lint": "eslint --ext .ts,.tsx .",
		"format": "pnpm prettier --write . && pnpm format-check && pnpm lint",
		"lint:check": "pnpm prettier --check .",
		"lint:fix": "pnpm prettier --write .",
		"check-updates": "pnpm npm-check-updates",
		"updates-packages": "pnpm npm-check-updates -u"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"dependencies": {
		"react": "latest",
		"react-dom": "latest",
		"react-redux": "latest",
		"react-router-dom": "^7.9.6",
		"dash-utils": "workspace:*",
		"dash-admin": "workspace:*",
		"dash-admin-state": "workspace:*",
		"dash-components": "workspace:*",
		"dash-constants": "workspace:*",
		"dash-auth": "workspace:*",
		"dash-axios-hook": "workspace:*",
		"dash-dialog": "workspace:*",
		"dash-auto-admin": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"dash-tsconfig": "workspace:*",
		"dash-eslint": "workspace:*",
		"dash-prettier": "workspace:*",
		"eslint": "latest",
		"typescript": "latest"
	},
	"peerDependencies": {
		"react": "latest",
		"react-dom": "latest"
	},
	"eslintConfig": {
		"extends": "react-app"
	}
}
