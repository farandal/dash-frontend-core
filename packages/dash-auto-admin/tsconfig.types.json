{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist"
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": [
		"node_modules",
		"src/**/*.spec.ts",
		"src/**/*.spec.tsx",
		"src/stories/**/*.stories.tsx",
		"src/**/*.bkup",
		"src/**/*.review.tsx",
		"src/**/*.wip"
	]
}
