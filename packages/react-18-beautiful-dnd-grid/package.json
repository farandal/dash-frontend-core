{
	"name": "react-18-beautiful-dnd-grid",
	"version": "1.0.0",
	"description": "Grid management for react-beautiful-dnd",
	"main": "src/index.ts",
	"module": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"require": "./src/index.ts"
		}
	},
	"private": false,
	"type": "module",
	"files": [
		"lib",
		"src"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"tsc": "tsc -p tsconfig.json",
		"test": "jest --watch --config jest.config.json",
		"format": "prettier --write 'src/**/*.{ts,tsx}'",
		"build": "echo 'Skipping build for react-18-beautiful-dnd-grid'",
		"_build": "rm -rf lib && mkdir lib && tsc -p tsconfig.build.json --noEmitOnError false",
		"test:pack": "npm run build && npm pack",
		"test:demo": "npm run build && rm -rf demo/src/lib && cp -r lib demo/src/lib",
		"prepublishOnly": "npm run build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mathieueveillard/react-beautiful-dnd-grid.git"
	},
	"keywords": [
		"react",
		"dnd",
		"grid",
		"component"
	],
	"author": "Mathieu Eveillard",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/mathieueveillard/react-beautiful-dnd-grid/issues"
	},
	"homepage": "https://github.com/mathieueveillard/react-beautiful-dnd-grid#readme",
	"devDependencies": {
		"@types/enzyme": "^3.10.3",
		"@types/enzyme-adapter-react-16": "^1.0.5",
		"@types/jest": "^24.0.18",
		"@types/node": "^12.7.7",
		"@types/react": "^16.9.3",
		"@types/uuid": "^3.4.5",
		"dash-tsconfig": "workspace:*",
		"enzyme": "^3.10.0",
		"enzyme-adapter-react-16": "^1.14.0",
		"jest": "^24.9.0",
		"jsdom": "^15.1.1",
		"prettier": "^1.18.2",
		"react-dom": "^16.9.0",
		"ts-jest": "^24.1.0",
		"typescript": "^3.6.3"
	},
	"dependencies": {
		"@hello-pangea/dnd": "^18.0.1",
		"@react-dnd/asap": "^5.0.2",
		"nanoid": "^5.0.8",
		"react": "19.2.8"
	},
	"eslintConfig": {
		"extends": "react-app"
	},
	"prettier": {
		"printWidth": 120
	}
}
