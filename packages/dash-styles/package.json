{
  "name": "dash-styles",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.tsx",
  "exports": {
    ".": {
      "import": "./src/index.tsx",
      "require": "./src/index.tsx"
    },
    "./dash.less": {
