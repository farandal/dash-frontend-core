        backgroundColor: `var(--btn-bg${currentTheme === 'dark' ? '--dark' : '--light'})`,
        color: `var(--btn-color${currentTheme === 'dark' ? '--dark' : '--light'})`,

        '&.MuiButton-containedPrimary': {
          backgroundColor: `var(--primary-color${currentTheme === 'dark' ? '--dark' : '--light'})`,
