		"@rollup/plugin-replace": "latest",
		"@rollup/plugin-typescript": "latest",
		"dash-admin-state": "*",
        "dash-styles": "*",
		"dash-auto-admin": "*",
		"dash-constants": "*",
		"dash-dialog": "*",
		"framer-motion": "latest",
		"prop-types": "latest",
		"query-string": "latest",
		"ra-input-rich-text": "latest",
		"react": "latest",
		"react-admin": "latest",
		"react-custom-scrollbars-2": "latest",
		"react-hook-form": "latest",
		"react-loading-overlay-ts": "latest",
		"react-query": "latest",
