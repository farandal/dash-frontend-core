{
	"name": "dash-admin",
	"version": "1.0.0",
	"private": true,
	"main": "src/index.tsx",
	"type": "module",
	"scripts": {
		"lint": "eslint --ext .ts,.tsx .",
		"format": "yarn prettier --write . && yarn format-check && yarn lint",
		"lint:check": "yarn prettier --check .",
		"lint:fix": "yarn prettier --write .",
		"prepare": "husky install",
		"check-updates": "yarn npm-check-updates",
		"updates-packages": "yarn npm-check-updates -u"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"dependencies": {
		"@emotion/react": "latest",
		"@emotion/styled": "latest",
		"@mui/material": "latest",
