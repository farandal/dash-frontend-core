{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Storybook Config",
	"extends": "./base.json",
	"exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "src/**/*.spec.js"],
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.js",
		"src/custom.d.ts",
		"src/stories/**/*.stories.tsx"
	]
}
