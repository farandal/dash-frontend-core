{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Default",
	"compilerOptions": {
		"module": "commonjs",
		"declaration": true,
		"removeComments": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"importHelpers": true,
		"noImplicitAny": false,
		"noImplicitThis": true,
		"strictNullChecks": false,
		"experimentalDecorators": true,
		"target": "ES6",
		"lib": [
            "DOM",
            "DOM.Iterable",
            "ScriptHost",
            "ES2016.Array.Include",
            "es2017",
            "ESNext"
		],
	
		"skipLibCheck": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"typeRoots": [
			"dash/@types",
			"node_modules/@types"
		],
		"noFallthroughCasesInSwitch": true,
		"useDefineForClassFields": true,
		
        "allowJs": true,
        "noEmit": true,
        "incremental": true,
        "ignoredDiagnostics": [2769] 
        
	},
	"exclude": [
		"node_modules",
        "**/*.wip"
	]
}