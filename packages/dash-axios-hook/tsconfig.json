{
	"extends": "dash-tsconfig/base.json",
	"compilerOptions": {
		//"types": ["@types/jest", "@types/node"],
		"jsx": "preserve",
		"incremental": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.css",
		"src/**/*.ttf",
		"src/**/*.otf",
		"src/**/*.less"
	],
	"paths": {
		"@/*": ["./src/*"]
	},
	"exclude": ["node_modules"]
}
