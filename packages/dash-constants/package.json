{
	"name": "dash-constants",
	"version": "0.0.2",
	"license": "MIT",
	"main": "dist/index.js",
	"devDependencies": {
		"@commitlint/cli": "latest",
		"@commitlint/config-conventional": "latest",
		"@types/jest": "latest",
		"@types/node": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@typescript-eslint/eslint-plugin": "latest",
		"@typescript-eslint/parser": "latest",
		"eslint-config-airbnb-typescript": "latest",
		"eslint-config-prettier": "latest",
		"eslint-plugin-html": "latest",
		"eslint-plugin-import": "latest",
		"eslint-plugin-jsdoc": "latest",
		"eslint-plugin-json": "latest",
		"eslint-plugin-prettier": "latest",
		"ts-jest": "latest",
		"ts-loader": "latest",
		"tsconfig-paths": "latest",
		"typescript": "latest"
	},
	"dependencies": {
		"@mui/material": "^9.3.0"
	},
	"module": "dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*.js",
		"./src/*": "./dist/*.js"
	},
	"publishConfig": {
		"access": "public",
		"registry": "http://localhost:4873"
	},
	"scripts": {
		"build": "tsup && pnpm run build:types",
		"build:types": "../../node_modules/.bin/tsc -p tsconfig.json --declaration --emitDeclarationOnly --noEmit false --outDir dist --rootDir src --skipLibCheck; test -f dist/index.d.ts"
	},
	"type": "module",
	"files": [
		"dist"
	],
	"typesVersions": {
		"*": {
			"dist/*": [
				"dist/*"
			],
			"src/*": [
				"dist/*",
				"dist/*/index"
			],
			"*": [
				"dist/*",
				"dist/*/index"
			]
		}
	}
}
