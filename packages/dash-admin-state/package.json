{
	"name": "dash-admin-state",
	"version": "0.0.2",
	"license": "MIT",
	"main": "dist/index.js",
	"devDependencies": {
		"@commitlint/cli": "latest",
		"@commitlint/config-conventional": "latest",
		"@types/jest": "latest",
		"@types/node": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@typescript-eslint/eslint-plugin": "latest",
		"@typescript-eslint/parser": "latest",
		"eslint-config-airbnb-typescript": "latest",
		"eslint-config-prettier": "latest",
		"eslint-plugin-html": "latest",
		"eslint-plugin-import": "latest",
		"eslint-plugin-jsdoc": "latest",
		"eslint-plugin-json": "latest",
		"eslint-plugin-prettier": "latest",
		"ts-jest": "latest",
		"ts-loader": "latest",
		"tsconfig-paths": "latest",
		"typescript": "latest"
	},
	"dependencies": {
		"connected-react-router": "latest",
		"dash-auto-admin": "workspace:*",
		"dash-constants": "workspace:*",
		"dash-utils": "workspace:*",
		"history": "latest",
		"react-redux": "latest",
		"redux-saga": "latest",
		"redux-thunk": "^3.1.0"
	},
	"module": "dist/index.js",
	"types": "./src/index.tsx",
	"exports": {
		".": "./dist/index.js",
		"./redux/actions": "./dist/redux/actions/index.js",
		"./src/redux/actions": "./dist/redux/actions/index.js",
		"./redux/reducers": "./dist/redux/reducers/index.js",
		"./src/redux/reducers": "./dist/redux/reducers/index.js",
		"./redux/sagas": "./dist/redux/sagas/index.js",
		"./src/redux/sagas": "./dist/redux/sagas/index.js",
		"./redux/store": "./dist/redux/store/index.js",
		"./src/redux/store": "./dist/redux/store/index.js",
		"./*": "./dist/*.js",
		"./src/*": "./dist/*.js"
	},
	"publishConfig": {
		"access": "public",
		"registry": "http://localhost:4873"
	},
	"scripts": {
		"build": "tsup"
	},
	"type": "module",
	"files": [
		"dist",
		"src"
	],
	"typesVersions": {
		"*": {
			"src/*": [
				"src/*",
				"src/*/index"
			],
			"*": [
				"src/*",
				"src/*/index"
			]
		}
	}
}
