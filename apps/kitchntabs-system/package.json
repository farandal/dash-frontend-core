{
  "private": false,
  "version": "1.0.0",
  "name": "kitchntabs-system",
  "license": "UNLICENSED",
  "description": "KitchnTabs application using refactored kt-* packages",
  "imports": {
    "#/*": "./*"
  },
  "scripts": {
    "_LINTING": "linting and formatting scripts",
    "lint": "npx eslint --ext .ts,.tsx .",
    "format": "npx prettier --write . && pnpm format-check && pnpm lint",
    "lint:check": "npx prettier --check .",
    "lint:fix": "npx prettier --write .",
    "_DEV": "When running dev it will require the config generated by the parent script",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4048 npx vite",
    "_BUILD": "Build reads customMode from parent's build_config.json - called from parent scripts",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4048 npx vite build --emptyOutDir",
    "_VITE": "default scripts",
    "vite": "npx vite",
    "vite-preview": "npx vite preview",
    "vite-build-watch": "cross-env NODE_OPTIONS=--max-old-space-size=8196 npx vite build --watch --emptyOutDir",
    "vite-prod": "cross-env NODE_OPTIONS=--max-old-space-size=14336 npx vite build --emptyOutDir"
  },
  "_notes": "This app uses the refactored kt-* packages for all domain-specific functionality",
  "homepage": "./",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/lab": "latest",
    "@mui/material": "latest",
    "@mui/system": "latest",
    "@mui/utils": "latest",
    "@mui/x-date-pickers": "^8.10.0",
    "@reduxjs/toolkit": "latest",
    "@tanstack/query-async-storage-persister": "^5.90.15",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-persist-client": "^5.90.15",
    "@types/qrcode.react": "^3.0.0",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "@dashadmin/dash-boilerplate": "workspace:*",
    "@dashadmin/dash-admin-state": "workspace:*",
    "@dashadmin/dash-app-common": "workspace:*",
    "@dashadmin/dash-auth": "workspace:*",
    "@dashadmin/dash-auto-admin": "workspace:*",
    "@dashadmin/dash-axios-hook": "workspace:*",
    "@dashadmin/dash-components": "workspace:*",
    "@dashadmin/dash-constants": "workspace:*",
    "@dashadmin/dash-dialog": "workspace:*",
    "@dashadmin/dash-interfaces": "workspace:*",
    "@dashadmin/dash-modal": "workspace:*",
    "@dashadmin/dash-styles": "workspace:*",
    "@dashadmin/dash-tsconfig": "workspace:*",
    "@dashadmin/dash-utils": "workspace:*",
    "js-cookie": "latest",
    "@dashadmin/kt-cashcount": "workspace:*",
    "@dashadmin/kt-ecommerce": "workspace:*",
    "@dashadmin/kt-kiosk": "workspace:*",
    "@dashadmin/kt-pages": "workspace:*",
    "@dashadmin/kt-utils": "workspace:*",
    "laravel-echo": "latest",
    "lodash": "^4.17.21",
    "pusher-js": "^8.4.0",
    "qrcode.react": "^4.2.0",
    "ra-core": "^5.14.7",
    "ra-i18n-polyglot": "^5.14.7",
    "ra-language-spanish": "^1.0.0",
    "react": "latest",
    "react-admin": "5.14.7",
    "react-dom": "latest",
    "react-error-boundary": "latest",
    "react-is": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-owl-carousel": "^2.3.3",
    "react-player": "^3.4.0",
    "react-redux": "latest",
    "react-router": "7.17.0",
    "react-router-dom": "7.17.0",
    "react-router-hash-link": "^2.4.3",
    "react-toastify": "latest",
    "redux": "latest",
    "redux-persist": "latest",
    "swiper": "^12.0.3",
    "@dashadmin/dash-admin": "workspace:*"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "@dashadmin/dash-eslint": "workspace:*",
    "@dashadmin/dash-prettier": "workspace:*",
    "less": "latest",
    "less-loader": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-svgr": "latest"
  }
