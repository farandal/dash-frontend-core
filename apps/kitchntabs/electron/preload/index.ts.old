import { ipcRenderer, contextBridge  } from 'electron'

console.log("Preload script loaded: electron-store required here");

// @ts-ignore
const _Store = require('electron-store');
const Store = _Store.default || _Store;

let store: any = null;
function getStore() {
    if (!store) {
        try {
            store = new Store();
        } catch (e) {
            console.error('Failed to initialize electron-store:', e);
            throw e;
        }
    }
    return store;
}
// --------- Expose some API to the Renderer process ---------
contextBridge.exposeInMainWorld('ipcRenderer', withPrototype(ipcRenderer))

// `exposeInMainWorld` can't detect attributes and methods of `prototype`, manually patching it.
function withPrototype(obj: Record<string, any>) {
  const protos = Object.getPrototypeOf(obj)

  for (const [key, value] of Object.entries(protos)) {
    if (Object.prototype.hasOwnProperty.call(obj, key)) continue

    if (typeof value === 'function') {
      // Some native APIs, like `NodeJS.EventEmitter['on']`, don't work in the Renderer process. Wrapping them into a function.
      obj[key] = function (...args: any) {
        return value.call(obj, ...args)
      }
    } else {
      obj[key] = value
    }
  }
  return obj
}

// --------- Preload scripts loading ---------
function domReady(condition: DocumentReadyState[] = ['complete', 'interactive']) {
  return new Promise(resolve => {
    if (condition.includes(document.readyState)) {


        console.log("Document is already ready:", document.readyState)

      resolve(true)
    } else {
      document.addEventListener('readystatechange', () => {
        if (condition.includes(document.readyState)) {
          resolve(true)
        }
      })
    }
  })
}

const safeDOM = {
  append(parent: HTMLElement, child: HTMLElement) {
    if (!Array.from(parent.children).find(e => e === child)) {
      return parent.appendChild(child)
    }
  },
  remove(parent: HTMLElement, child: HTMLElement) {
    if (Array.from(parent.children).find(e => e === child)) {
      return parent.removeChild(child)
    }
  },
}

/**
 * https://tobiasahlin.com/spinkit
 * https://connoratherton.com/loaders
 * https://projects.lukehaas.me/css-loaders
 * https://matejkustec.github.io/SpinThatShit
 */
function useLoading() {

  const oStyle = document.createElement('style')
  const oDiv = document.createElement('div')
  oStyle.id = 'app-loading-style'
  oDiv.className = 'app-loading-wrap'
  oDiv.innerHTML = `<div class="dash-loader"><div></div></div>`

  return {
    appendLoading() {
      safeDOM.append(document.head, oStyle)
      safeDOM.append(document.body, oDiv)
    },
    removeLoading() {
      safeDOM.remove(document.head, oStyle)
      safeDOM.remove(document.body, oDiv)
    },
  }
}

// ----------------------------------------------------------------------

const { appendLoading, removeLoading } = useLoading()
domReady().then(appendLoading)

window.onmessage = (ev) => {


  ev.data.payload === 'removeLoading' && removeLoading()
}

contextBridge.exposeInMainWorld('DashIPCService', {

  runPythonScript: (filePath:string, scriptPath:string, args:string[]) => {
    console.log("ipcRenderer contextBridge run-python-script")
    console.log( filePath,scriptPath, args)
    ipcRenderer.send('run-python-script', filePath,scriptPath, args);
  },

  action: (action:string, payload:any) => {
    console.log("ipcRenderer contextBridge action",action,payload)
    ipcRenderer.send('ipc-action',action,payload);
  },

  onPythonOutput: (callback:any) => {
    ipcRenderer.on('python-output', (event, data) => {
      console.log("python-output")
      callback(data);
    });
  },

  onServiceMessage: (callback:any) => {
    ipcRenderer.on('service', (event, data) => {
      //console.log("onServiceMessage  ipcRenderer.on(service)",data)
      callback(data);
    });
  },

  // Add a new method to capture all stdout
  onStdout: (callback:any) => {
    ipcRenderer.on('stdout', (event, data) => {
      console.log("Standard Output:", data);
      callback(data);
    });
  },

  // Add electron-log handler
  onElectronLog: (callback:any) => {
    ipcRenderer.on('electron-log', (event, logData) => {
      console.log(`Electron Log [${logData.level}]:`, logData.message);
      callback(logData);
    });
  },

  // Add subprocess output handler
  onSubprocessOutput: (callback:any) => {
    ipcRenderer.on('subprocess-output', (event, data) => {
      console.log(`Subprocess [${data.type}]:`, data.message);
      callback(data);
    });
  },

  windowControls: (action:string) => ipcRenderer.send('window-controls', action),
  startDrag: () => ipcRenderer.send('window-drag-start'),
});

contextBridge.exposeInMainWorld('electronStore', {
  get: (key: string) => getStore().get(key),
  set: (key: string, value: any) => getStore().set(key, value),
  delete: (key: string) => getStore().delete(key),
  clear: () => getStore().clear(),
});

setTimeout(removeLoading, 4999)