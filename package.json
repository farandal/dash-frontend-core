{
  "name": "dash-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/**/*"
  ],
  "scripts": {
    "new": "chmod +x ./new.sh && ./new.sh",
    "dev": "cd apps/dash && yarn dev",
    "build": "turbo build --filter=!./apps/demo --filter=!./packages/react-18-beautiful-dnd-grid",
    "android": "NODE_ENV=staging turbo build && cap run android",
    "android-prod": "NODE_ENV=production turbo build && cap run android",
    "resources": "chmod +x ./resources.sh && ./resources.sh",
    "sync-envs": "chmod +x ./env-sync.sh && ./env-sync.sh",
    "lint": "turbo run lint",
    "lint:packages": "npm-run-all --parallel --print-label --continue-on-error lint:packages:*",
    "lint:packages:semver": "syncpack lint-semver-ranges",
    "lint:packages:mismatches": "syncpack list-mismatches",
    "lint:check": "prettier --check \"**/*.{js,ts,tsx,md,mdx,json}\"",
    "lint:fix": "prettier --write  \"**/*.{js,ts,tsx,md,mdx,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "add-changeset": "changeset add",
    "version-packages": "changeset version",
    "prepare": "husky install",
    "prerelease": "yarn run build",
    "release": "changeset publish",
    "test": "turbo run test",
    "types:check": "turbo run types:check"
  },
  "dependencies": {
    "dash-eslint": "*",
    "dash-prettier": "*"
  },
  "devDependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "@changesets/cli": "latest",
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@types/jest": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "capacitor-resources": "^2.0.5",
    "depcheck": "latest",
    "husky": "latest",
    "npm-run-all": "latest",
    "postcss": "latest",
    "prettier": "latest",
    "syncpack": "latest",
    "turbo": "latest"
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=20.18.3",
    "npm": ">=9.6.7"
  }
}
