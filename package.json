{
  "name": "dash-frontend",
  "description": "Frontend application for the DASH platform",
  "author": "Francisco Aranda <farandal@gmail.com>",
  "license": "MIT",
  "private": true,
  "version": "1.0.0",
  "main": "apps/dash/dist-electron/main/index.js",
  "workspaces": [
    "apps/*",
    "packages/**/*"
  ],
  "scripts": {
    "new": "chmod +x ./new.sh && sh ./new.sh",
    "dev": "cd apps/dash && yarn dev",
    "dev-win": "cd apps/dash && yarn dev-win",
    "build": "turbo build --filter=!./apps/demo --filter=!./packages/react-18-beautiful-dnd-grid",
    "build-win": "cd apps/dash && yarn build-win",
    "android": "NODE_ENV=staging turbo build && cap run android",
    "android-prod": "NODE_ENV=production turbo build && cap run android",
    "electron-icons": "electron-icon-builder --input=./apps/dash/src/assets/logo.png --output=./",
    "electron-dev": "vite build -c electron.vite.config.ts && cross-env NODE_ENV=development BUILD_ENV=dev concurrently \"cd apps/dash && yarn -silent dev &\" \"wait-on http://127.0.0.1:3006 && electron .\"",
    "electron-dev-win": "vite build -c electron.vite.config.ts && cross-env NODE_ENV=development BUILD_ENV=dev concurrently --kill-others --raw \"cd apps/dash && yarn dev-win\" \"wait-on -v http://127.0.0.1:3006 && electron .\"",
    "electron-prod": "cross-env NODE_ENV=production BUILD_ENV=prod yarn build && vite build -c electron.vite.config.ts && electron-builder --config electron-builder.config.js",
    "electron-prod-win": "electron-icon-builder --input=./apps/dash/src/assets/logo.png --output=./ && cross-env NODE_ENV=production BUILD_ENV=prod yarn build-win && vite build -c electron.vite.config.ts && electron-builder --config electron-builder.config.js",
    "electron-preview": "vite preview",
    "electron-pree2e": "vite build --mode=test",
    "resources": "chmod +x ./resources.sh && ./resources.sh",
    "sync-envs": "chmod +x ./env-sync.sh && ./env-sync.sh",
    "lint": "turbo run lint",
    "lint:packages": "npm-run-all --parallel --print-label --continue-on-error lint:packages:*",
    "lint:packages:semver": "syncpack lint-semver-ranges",
    "lint:packages:mismatches": "syncpack list-mismatches",
    "lint:check": "prettier --check \"**/*.{js,ts,tsx,md,mdx,json}\"",
    "lint:fix": "prettier --write  \"**/*.{js,ts,tsx,md,mdx,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "add-changeset": "changeset add",
    "version-packages": "changeset version",
    "prepare": "husky install",
    "prerelease": "yarn run build",
    "release": "changeset publish",
    "test": "turbo run test",
    "types:check": "turbo run types:check"
  },
  "dependencies": {
    "@types/sound-play": "^1.1.3",
    "dash-eslint": "*",
    "dash-prettier": "*",
    "electron-updater": "^6.6.2",
    "vite-plugin-electron": "^0.29.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "@changesets/cli": "latest",
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@types/jest": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "capacitor-resources": "^2.0.5",
    "concurrently": "^9.1.2",
    "depcheck": "latest",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "electron-log": "^5.3.3",
    "husky": "latest",
    "mkdirp": "^3.0.1",
    "npm-run-all": "latest",
    "postcss": "latest",
    "prettier": "latest",
    "sound-play": "^1.1.0",
    "syncpack": "latest",
    "turbo": "latest",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.3"
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=20.18.3",
    "npm": ">=9.6.7"
  },
  "permissions": [
    "audio"
  ],
  "build": {
    "asar": false,
    "directories": {
      "output": "release/"
    },
    "files": [
      "electron/**/*",
      "electron-config.yaml",
      "resources/sounds",
      "apps/dash/dist/**",
      "apps/dash/dist-electron/**",
      "apps/dash/electron-config.prod.yaml",
      "../dash-python-service/service/ws_service.exe"
    ]
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3007/",
      "BUILD_ENV": "DEV",
      "VITE_PROJECT_PATH": "apps/dash"
    }
  },
  "resolutions": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
